<?xml version="1.0" encoding="utf-8"?>
<!--
    Ý tưởng: 1 thân camera (thân bo góc + ô ngắm nhỏ phía trên) + ống kính tròn ở giữa + 1 chấm
    đỏ "đang ghi/trực tiếp" ở góc trên-phải -> truyền tải đúng chức năng camera giám sát gia
    đình đang hoạt động, không cần chữ.
    Các hình chính nằm trong/gần vùng an toàn 66dp (bán kính 33dp quanh tâm 54,54) theo chuẩn
    Adaptive Icon, để không bị các launcher cắt mất phần quan trọng khi mask theo hình tròn/
    vuông bo góc/giọt nước.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Ô ngắm nhỏ phía trên thân camera -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M46,36 L62,36 A2,2 0 0,1 64,38 L64,44 L44,44 L44,38 A2,2 0 0,1 46,36 Z" />

    <!-- Thân camera (bo góc) -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M36,44 L78,44 A4,4 0 0,1 82,48 L82,72 A4,4 0 0,1 78,76 L36,76 A4,4 0 0,1 32,72 L32,48 A4,4 0 0,1 36,44 Z" />

    <!-- Vòng ngoài ống kính -->
    <path
        android:fillColor="@color/ic_launcher_lens"
        android:pathData="M41,60 A13,13 0 1,0 67,60 A13,13 0 1,0 41,60 Z" />

    <!-- Kính ống kính (highlight giữa) -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M48,60 A6,6 0 1,0 60,60 A6,6 0 1,0 48,60 Z" />

    <!-- Chấm đỏ "đang ghi / đang trực tiếp" -->
    <path
        android:fillColor="@color/ic_launcher_rec_dot"
        android:pathData="M70,50 A4,4 0 1,0 78,50 A4,4 0 1,0 70,50 Z" />
</vector>
