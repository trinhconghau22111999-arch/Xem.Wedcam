<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Cần internet để kết nối Firebase (signaling) và truyền video WebRTC -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Máy Camera: cần camera sau để quay -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="true" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <!-- Hiện thông báo liên tục khi camera/ghi hình đang chạy nền -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Giữ máy Camera không ngủ trong lúc đang truyền hình (tắt màn hình vẫn chạy) -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Tự khởi động lại camera sau khi máy khởi động lại (mất điện, bật nguồn lại) -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Xin loại trừ khỏi tối ưu pin để service không bị hệ thống giết khi màn hình tắt lâu -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.HomeCamera">

        <!-- Màn hình chọn vai trò: Camera hay Máy Xem -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Máy B: màn hình xin sự đồng ý + tạo mã ghép nối cho camera -->
        <activity android:name=".CameraActivity" android:exported="false" />

        <!-- Tự khởi động lại camera sau khi máy khởi động lại / app vừa được cập nhật -->
        <receiver android:name=".BootReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Máy A: màn hình nhập mã + xem/ghi hình từ camera -->
        <activity android:name=".ViewerActivity" android:exported="false" />

        <!-- Máy A: danh sách video đã lưu (4 cột A-D) + xem nhiều video cùng lúc -->
        <activity android:name=".VideoGalleryActivity" android:exported="false" />
        <activity android:name=".MultiViewPlayerActivity" android:exported="false" />

        <!--
            Foreground Service trên Máy B: bật camera sau, giữ thông báo liên tục
            trong suốt thời gian camera đang hoạt động (kể cả khi chưa ai xem).
        -->
        <service
            android:name=".CameraStreamService"
            android:exported="false"
            android:foregroundServiceType="camera" />

        <!--
            Foreground Service trên Máy A: giữ kết nối WebRTC + ghi các đoạn video 15 phút,
            lưu vĩnh viễn ngay trên máy này, chạy độc lập với vòng đời màn hình xem.
        -->
        <service
            android:name=".ViewerRecordingService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

    </application>
</manifest>
